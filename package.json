{
  "name": "aldebaran",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run --project server-unit --project web",
    "test:integration": "vitest run --project server-integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
